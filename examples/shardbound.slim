  overlay_panel(0.08, 0.18, 0.16);
  tri(400, 215, 475, 350, 325, 350, 0.26, 0.98, 0.61);
  tri(400, 245, 445, 326, 355, 326, 0.98, 0.90, 0.31);
  tri(280, 395, 330, 365, 380, 395, 0.98, 0.69, 0.25);
