fn absolute(value) {
  if (value < 0) {
    return -value;
  }
  return value;
}

fn clamp(value, low, high) {
  if (value < low) {
    return low;
  }
  if (value > high) {
    return high;
  }
  return value;
}

fn visible(left, right) {
  if (right > camera_x - 50 && left < camera_x + 850) {
    return 1;
  }
  return 0;
}

// The atlas is world independent. A small shear gives walk and jump poses
// without duplicating geometry. A negative flip mirrors the fox horizontally.
fn draw_part(start, count, x, y, scale, flip, tilt) {
  let i = start;
  while (i < start + count) {
    let base = i * ATLAS_STRIDE;
    let ax1 = ATLAS[base];
    let ay1 = ATLAS[base + 1];
    let ax2 = ATLAS[base + 2];
    let ay2 = ATLAS[base + 3];
    let ax3 = ATLAS[base + 4];
    let ay3 = ATLAS[base + 5];
    let x1 = x + ax1 * scale * flip - camera_x;
    let y1 = y + (ay1 + ax1 * tilt) * scale;
    let x2 = x + ax2 * scale * flip - camera_x;
    let y2 = y + (ay2 + ax2 * tilt) * scale;
    let x3 = x + ax3 * scale * flip - camera_x;
    let y3 = y + (ay3 + ax3 * tilt) * scale;
    tri(x1, y1, x2, y2, x3, y3, ATLAS[base + 6], ATLAS[base + 7], ATLAS[base + 8]);
    i = i + 1;
  }
}

fn hero(x, y, facing, pose) {
  let tilt = 0;
  if (pose == 1) {
    tilt = 0.07;
  }
  if (pose == 2) {
    tilt = -0.04;
  }
  draw_part(22, 5, x, y, 1, facing, tilt);
  draw_part(18, 4, x, y, 1, facing, tilt);
  draw_part(0, 5, x, y, 1, facing, tilt);
  draw_part(5, 11, x, y, 1, facing, tilt);
  draw_part(16, 2, x, y, 1, facing, tilt);
  draw_part(27, 3, x, y, 1, facing, tilt);
}

fn beetle(x, y, phase) {
  let lean = 0;
  if (phase == 1) {
    lean = 0.08;
  }
  draw_part(30, 12, x, y, 0.85, 1, lean);
}

fn fly(x, y, phase) {
  let lean = -0.04;
  if (phase == 1) {
    lean = 0.04;
  }
  draw_part(42, 11, x, y, 0.90, 1, lean);
}

fn surface(x, previous) {
  let top = -1000;
  let i = 0;
  while (i < TERRAIN_COUNT) {
    if (TERRAIN_LEVEL[i] == current_level && x >= TERRAIN_LEFT[i] && x < TERRAIN_LEFT[i] + TERRAIN_WIDTH[i] && previous <= TERRAIN_TOP[i]) {
      if (top < -500 || TERRAIN_TOP[i] < top) {
        top = TERRAIN_TOP[i];
      }
    }
    i = i + 1;
  }
  return top;
}

// The exact same rectangle arrays used for rendering also stop wall and
// ceiling crossings. Floors remain valid under raised platforms.
fn terrain_collision(index, old_x, old_y) {
  let left = TERRAIN_LEFT[index];
  let right = left + TERRAIN_WIDTH[index];
  let top = TERRAIN_TOP[index];
  let bottom = TERRAIN_BOTTOM[index];
  if (player_y > top + 2 && player_y - PLAYER_HEIGHT < bottom) {
    if (old_x <= left - PLAYER_HALF && player_x > left - PLAYER_HALF) {
      player_x = left - PLAYER_HALF;
      player_vx = 0;
    }
    if (old_x >= right + PLAYER_HALF && player_x < right + PLAYER_HALF) {
      player_x = right + PLAYER_HALF;
      player_vx = 0;
    }
  }
  if (player_vy < 0 && player_x > left - PLAYER_HALF && player_x < right + PLAYER_HALF && old_y - PLAYER_HEIGHT >= bottom && player_y - PLAYER_HEIGHT < bottom) {
    player_y = bottom + PLAYER_HEIGHT;
    player_vy = 0;
  }
}

fn terrain_collisions(old_x, old_y) {
  let i = 0;
  while (i < TERRAIN_COUNT) {
    if (TERRAIN_LEVEL[i] == current_level) {
      terrain_collision(i, old_x, old_y);
    }
    i = i + 1;
  }
}

