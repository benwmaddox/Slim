fn terminal_loss() {
  overlay_panel(0.20, 0.07, 0.12);
  tri(300, 240, 350, 240, 500, 370, 0.96, 0.16, 0.24);
  tri(500, 240, 450, 240, 300, 370, 0.96, 0.16, 0.24);
  tri(400, 250, 440, 320, 360, 320, 0.99, 0.58, 0.20);
