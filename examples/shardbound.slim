fn exit_gate() {
  let x = LEVEL_EXIT_X[current_level];
  let sx = x - camera_x;
  let unlocked = 0;
  if (gem_count >= LEVEL_REQUIRED_GEMS[current_level]) {
    unlocked = 1;
  }
  if (visible(x - 38, x + 38) == 1) {
    tri(sx - 32, 500, sx - 32, 390, sx, 360, 0.24, 0.17, 0.20);
    tri(sx - 32, 500, sx, 360, sx + 32, 500, 0.11, 0.08, 0.13);
    if (unlocked == 1) {
      tri(sx - 23, 490, sx, 388, sx + 23, 490, 0.33, 0.95, 0.55);
      tri(sx - 13, 474, sx, 412, sx + 13, 474, 0.95, 0.86, 0.31);
    } else {
      tri(sx - 23, 490, sx, 388, sx + 23, 490, 0.90, 0.20, 0.22);
    }
  }
}

fn enemies_scene() {
  let i = 0;
  while (i < ENEMY_COUNT) {
    if (ENEMY_LEVEL[i] == current_level && enemy_alive[i] == 1) {
      let phase = enemy_clock % 2;
      let y = ENEMY_Y[i];
      if (ENEMY_TYPE[i] == 0) {
        beetle(enemy_x[i], y, phase);
      } else {
        y = y + (enemy_clock % 40 - 20) * 0.45;
        fly(enemy_x[i], y, phase);
      }
    }
    i = i + 1;
  }
}

fn hud() {
  let required = LEVEL_REQUIRED_GEMS[current_level];
  let progress = gem_count * 46;
  tri(18, 18, 782, 18, 782, 49, 0.08, 0.06, 0.12);
  tri(18, 18, 782, 49, 18, 49, 0.12, 0.08, 0.16);
  tri(30, 33, 130, 33, 130, 40, 0.23, 0.18, 0.24);
  tri(30, 33, 130, 40, 30, 40, 0.91, 0.67, 0.22);
  tri(138, 33, 138 + progress, 33, 138 + progress, 40, 0.30, 0.95, 0.72);
  tri(138, 33, 138 + progress, 40, 138, 40, 0.94, 0.98, 0.44);
  let i = 0;
  while (i < 3) {
    let px = 610 + i * 38;
    if (i < current_level) {
      tri(px, 39, px + 14, 25, px + 28, 39, 0.31, 0.95, 0.57);
    } else if (i == current_level) {
      tri(px, 39, px + 14, 25, px + 28, 39, 0.98, 0.74, 0.28);
    } else {
      tri(px, 39, px + 14, 25, px + 28, 39, 0.25, 0.21, 0.28);
    }
    i = i + 1;
  }
  // Tiny gem pips keep the requirement visible without a text dependency.
  i = 0;
  while (i < required) {
    let gem_px = 190 + i * 28;
    if (i < gem_count) {
      tri(gem_px, 32, gem_px + 8, 24, gem_px + 16, 32, 0.37, 0.98, 0.84);
      tri(gem_px, 32, gem_px + 16, 32, gem_px + 8, 41, 0.98, 0.92, 0.39);
    } else {
      tri(gem_px, 32, gem_px + 8, 24, gem_px + 16, 32, 0.30, 0.24, 0.32);
    }
    i = i + 1;
  }
}

fn overlay_panel(red, green, blue) {
  tri(130, 190, 670, 190, 670, 405, red, green, blue);
  tri(130, 190, 670, 405, 130, 405, red * 0.78, green * 0.78, blue * 0.82);
}

fn transition_scene() {
  overlay_panel(0.10, 0.08, 0.16);
  let i = 0;
  while (i < current_level + 1) {
    let px = 330 + i * 58;
    tri(px, 300, px + 24, 270, px + 48, 300, 0.32, 0.95, 0.65);
    tri(px, 300, px + 48, 300, px + 24, 330, 0.98, 0.78, 0.25);
    i = i + 1;
  }
}

