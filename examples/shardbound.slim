fn scene() {
  background();
  if (state == STATE_PLAYING || state == STATE_TRANSITION) {
    terrain_scene();
    hazards_scene();
    gems_scene();
    enemies_scene();
    exit_gate();
    hero(player_x, player_y, player_facing, player_pose);
    hud();
  }
  if (state == STATE_TRANSITION) {
    transition_scene();
  }
  if (state == STATE_WON) {
    terminal_win();
  }
  if (state == STATE_LOST) {
    terminal_loss();
  }
}

fn reset_gems() {
  let i = 0;
  while (i < GEM_COUNT) {
    gem_taken[i] = 0;
    i = i + 1;
  }
}

fn reset_enemies() {
  let i = 0;
  while (i < ENEMY_COUNT) {
    enemy_x[i] = ENEMY_START_X[i];
    enemy_dir[i] = 1;
    enemy_alive[i] = 1;
    i = i + 1;
  }
}

fn reset_level() {
  player_x = LEVEL_START_X[current_level];
  player_y = 500;
  player_vx = 0;
  player_vy = 0;
  player_ground = 1;
  player_facing = 1;
  player_pose = 0;
  jump_hold = 0;
  camera_x = 0;
  state = STATE_PLAYING;
  transition_timer = 0;
  gem_count = 0;
  reset_gems();
  reset_enemies();
}

fn init() {
  current_level = 0;
  walk_clock = 0;
  enemy_clock = 0;
  reset_level();
}

fn collect_gems() {
  let i = 0;
  while (i < GEM_COUNT) {
    if (GEM_LEVEL[i] == current_level && gem_taken[i] == 0 && absolute(player_x - GEM_X[i]) < 30 && absolute(player_y - GEM_Y[i]) < 52) {
      gem_taken[i] = 1;
      gem_count = gem_count + 1;
      sound(SOUND_COLLECT, 10 + gem_count * 2, 0.07);
    }
    i = i + 1;
  }
}

fn lose() {
  if (state == STATE_PLAYING) {
    state = STATE_LOST;
    sound(SOUND_LOSS, -5, 0.18);
  }
}

fn check_hazards() {
  let i = 0;
  while (i < HAZARD_COUNT) {
    if (HAZARD_LEVEL[i] == current_level && absolute(player_x - HAZARD_X[i]) < HAZARD_WIDTH[i] + PLAYER_HALF && absolute(player_y - HAZARD_Y[i]) < 66) {
      lose();
    }
    i = i + 1;
  }
}

fn check_enemy_hit(index, y) {
  if (absolute(player_x - enemy_x[index]) < 34 && absolute(player_y - y) < 34) {
    if (player_vy > 0 && player_y - player_vy < y - 20) {
      enemy_alive[index] = 0;
      player_vy = -9;
      sound(SOUND_COLLECT, 5, 0.09);
    } else {
      lose();
    }
  }
}

fn update_enemies() {
  let i = 0;
  while (i < ENEMY_COUNT) {
    if (ENEMY_LEVEL[i] == current_level && enemy_alive[i] == 1) {
      if (ENEMY_TYPE[i] == 0) {
        enemy_x[i] = enemy_x[i] + enemy_dir[i] * 0.62;
        if (enemy_x[i] > ENEMY_START_X[i] + ENEMY_PATROL[i]) {
          enemy_dir[i] = -1;
        }
        if (enemy_x[i] < ENEMY_START_X[i] - ENEMY_PATROL[i]) {
          enemy_dir[i] = 1;
        }
        check_enemy_hit(i, ENEMY_Y[i]);
      } else {
        let fly_y = ENEMY_Y[i] + (enemy_clock % 40 - 20) * 0.45;
        check_enemy_hit(i, fly_y);
      }
    }
    i = i + 1;
  }
}

fn advance_level() {
  if (current_level + 1 >= LEVEL_COUNT) {
    state = STATE_WON;
    sound(SOUND_WIN, 12, 0.20);
  } else {
    current_level = current_level + 1;
    player_x = LEVEL_START_X[current_level];
    player_y = 500;
    player_vx = 0;
    player_vy = 0;
    player_ground = 1;
    player_facing = 1;
    player_pose = 0;
    camera_x = 0;
    gem_count = 0;
    transition_timer = 0;
    state = STATE_PLAYING;
    reset_gems();
    reset_enemies();
  }
}

fn update_transition() {
  transition_timer = transition_timer - 1;
  if (transition_timer <= 0) {
    advance_level();
  }
}

fn update_player() {
  let direction = 0;
  if (input(INPUT_LEFT) > 0) {
    direction = direction - 1;
  }
  if (input(INPUT_RIGHT) > 0) {
    direction = direction + 1;
  }
  if (direction != 0) {
    player_vx = player_vx + direction * 0.70;
    player_facing = direction;
  } else {
    player_vx = player_vx * 0.78;
  }
  player_vx = clamp(player_vx, -6, 6);
  if (input(INPUT_ACTION_PRESSED) > 0 && player_ground == 1) {
    player_vy = -15;
    player_ground = 0;
    jump_hold = 8;
    sound(SOUND_JUMP, 8, 0.08);
  }
  if (input(INPUT_ACTION_HELD) > 0 && player_vy < 0 && jump_hold > 0) {
    player_vy = player_vy - 0.28;
    jump_hold = jump_hold - 1;
  } else {
    jump_hold = 0;
  }
  player_vy = clamp(player_vy + 0.72, -16, 15);
  let old_x = player_x;
  let old_y = player_y;
  player_x = clamp(player_x + player_vx, PLAYER_HALF, LEVEL_LENGTH[current_level] - PLAYER_HALF);
  player_y = player_y + player_vy;
  terrain_collisions(old_x, old_y);
  let top = surface(player_x, old_y);
  if (player_vy >= 0 && top > -500 && old_y <= top && player_y >= top) {
    player_y = top;
    player_vy = 0;
    player_ground = 1;
  } else {
    player_ground = 0;
  }
  if (player_y > 660) {
    lose();
  }
  collect_gems();
  check_hazards();
  update_enemies();
  if (player_x > LEVEL_EXIT_X[current_level] && gem_count >= LEVEL_REQUIRED_GEMS[current_level] && state == STATE_PLAYING) {
    state = STATE_TRANSITION;
    transition_timer = LEVEL_TRANSITION_TICKS;
    sound(SOUND_TRANSITION, 7, 0.14);
  }
}

fn update_camera() {
  if (player_x - camera_x > 280) {
    camera_x = player_x - 280;
  }
  if (camera_x < 0) {
    camera_x = 0;
  }
  if (camera_x > LEVEL_LENGTH[current_level] - 800) {
    camera_x = LEVEL_LENGTH[current_level] - 800;
  }
  if (camera_x < 0) {
    camera_x = 0;
  }
}

fn update() {
  walk_clock = walk_clock + 1;
  if (walk_clock > 10000) {
    walk_clock = 0;
  }
  enemy_clock = enemy_clock + 1;
  if (enemy_clock > 10000) {
    enemy_clock = 0;
  }
  update_player();
  update_camera();
  if (player_ground == 0) {
    player_pose = 2;
  } else if (absolute(player_vx) > 0.20) {
    player_pose = walk_clock % 2;
  } else {
    player_pose = 0;
  }
}

fn frame() {
  if (input(INPUT_RESTART) > 0) {
    init();
  } else if (state == STATE_PLAYING) {
    update();
  } else if (state == STATE_TRANSITION) {
    update_transition();
  } else if (state == STATE_LOST && input(INPUT_ACTION_PRESSED) > 0) {
    reset_level();
  }
  scene();
}
