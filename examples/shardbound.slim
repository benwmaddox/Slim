fn terrain_piece(index) {
  let left = TERRAIN_LEFT[index];
  let right = left + TERRAIN_WIDTH[index];
  let top = TERRAIN_TOP[index];
  if (visible(left, right) == 1) {
    let a = left - camera_x;
    let b = right - camera_x;
    let ground_r = LEVEL_GROUND_R[current_level];
    let ground_g = LEVEL_GROUND_G[current_level];
    let ground_b = LEVEL_GROUND_B[current_level];
    tri(a, top, b, top, b, TERRAIN_BOTTOM[index], ground_r, ground_g, ground_b);
    tri(a, top, b, TERRAIN_BOTTOM[index], a, TERRAIN_BOTTOM[index], ground_r * 0.70, ground_g * 0.70, ground_b * 0.78);
    if (TERRAIN_KIND[index] == 0) {
      tri(a, top, b, top, b, top + 12, 0.58, 0.78, 0.31);
      tri(a, top, b, top + 12, a, top + 12, 0.31, 0.57, 0.25);
    } else {
      tri(a, top, b, top, b, top + 8, 0.91, 0.66, 0.24);
      tri(a, top, b, top + 8, a, top + 8, 0.57, 0.29, 0.18);
    }
  }
}

fn terrain_scene() {
  let i = 0;
  while (i < TERRAIN_COUNT) {
    if (TERRAIN_LEVEL[i] == current_level) {
      terrain_piece(i);
    }
    i = i + 1;
  }
}

fn gem(x, y, taken) {
  let sx = x - camera_x;
  if (taken == 0 && visible(x - 24, x + 24) == 1) {
    tri(sx, y - 18, sx + 16, y, sx, y + 18, 0.30, 0.95, 0.88);
    tri(sx, y - 18, sx, y + 18, sx - 16, y, 0.86, 0.99, 0.51);
    tri(sx, y - 11, sx + 7, y, sx, y + 8, 0.98, 1, 0.77);
  }
}

fn gems_scene() {
  let i = 0;
