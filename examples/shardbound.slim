  if (visible(x - width, x + width) == 1) {
    tri(sx - width, y, sx, y - 32, sx + width, y, 0.87, 0.15, 0.17);
    tri(sx - width, y, sx, y - 32, sx - width + 8, y, 0.98, 0.54, 0.22);
