const LEVEL_START = [19, 20, 49, 12, 15, 25];
const LEVEL_W = [7, 8, 9, 9, 9, 9];
const LEVEL_H = [5, 6, 7, 7, 7, 7];
const LEVEL_BOXES = [1, 2, 3, 3, 4, 4];

global current_level = 0;
global state = STATE_PLAY;
global player = 0;
global facing = DIR_DOWN;
global last_dir = -1;
global repeat = 0;
global covered = 0;
global origin_x = 0;
global origin_y = 0;
global crate = [0; CELLS];

// Animation state (see the lengths above).
global clock = 0;
global intro_t = 0;
global clear_t = 0;
global move_t = 0;
global move_dir = DIR_DOWN;
global push_cell = -1;
global bump_t = 0;
global bump_dir = DIR_DOWN;
global pulse_t = 0;
global pulse_cell = 0;

fn tile_at(index) {
  return LEVEL_MAP[current_level * CELLS + index];
}

fn walkable(index) {
  if (tile_at(index) >= TILE_FLOOR) {
    return 1;
  }
  return 0;
}

fn cell_col(index) {
  return index % STRIDE;
}

fn cell_row(index) {
  return floor(index / STRIDE);
}

fn dir_dx(dir) {
  if (dir == DIR_LEFT) {
    return -1;
  }
  if (dir == DIR_RIGHT) {
    return 1;
  }
  return 0;
}

fn dir_dy(dir) {
  if (dir == DIR_UP) {
    return -1;
  }
  if (dir == DIR_DOWN) {
    return 1;
  }
  return 0;
}

fn dir_delta(dir) {
  return dir_dx(dir) + dir_dy(dir) * STRIDE;
}

// 0 -> 1 -> 0 triangle wave over `period` ticks, used for gentle pulsing.
fn wave(period) {
  return 1 - abs(2 * (clock % period) / period - 1);
}

fn count_covered() {
  let total = 0;
  let i = 0;
  while (i < CELLS) {
    if (crate[i] == 1 && tile_at(i) == TILE_TARGET) {
      total = total + 1;
    }
    i = i + 1;
  }
  return total;
}

fn load_level(level) {
  current_level = level;
  state = STATE_PLAY;
  player = LEVEL_START[level];
  facing = DIR_DOWN;
  last_dir = -1;
  repeat = 0;
  intro_t = 0;
  clear_t = 0;
  move_t = 0;
  bump_t = 0;
  pulse_t = 0;
  push_cell = -1;
  origin_x = (800 - LEVEL_W[level] * TILE) / 2;
  origin_y = 66 + (500 - LEVEL_H[level] * TILE) / 2;
  let i = 0;
  while (i < CELLS) {
    crate[i] = LEVEL_BOX[level * CELLS + i];
    i = i + 1;
  }
  covered = count_covered();
}

fn init() {
  load_level(0);
}

fn push_crate(to, beyond) {
  crate[to] = 0;
  crate[beyond] = 1;
  player = to;
  move_t = MOVE_TICKS;
  push_cell = beyond;
  covered = count_covered();
  if (tile_at(beyond) == TILE_TARGET) {
    pulse_t = PULSE_TICKS;
    pulse_cell = beyond;
  }
  if (covered == LEVEL_BOXES[current_level]) {
    state = STATE_CLEAR;
    clear_t = 0;
    sound(SOUND_CLEAR, 7, 0.14);
  } else if (tile_at(beyond) == TILE_TARGET) {
    sound(SOUND_LAND, 8, 0.09);
  } else {
    sound(SOUND_STEP, -2, 0.08);
  }
}

fn bump(dir) {
  bump_t = BUMP_TICKS;
  bump_dir = dir;
  sound(SOUND_BUMP, -6, 0.05);
}

// One step in a direction. Walls and pairs of crates block; a single crate in
// front is pushed one cell if the cell behind it is open.
fn try_move(dir) {
  facing = dir;
  let delta = dir_delta(dir);
  let to = player + delta;
  if (walkable(to) == 0) {
    bump(dir);
    return;
  }
  move_dir = dir;
  if (crate[to] == 1) {
    let beyond = to + delta;
    if (walkable(beyond) == 1 && crate[beyond] == 0) {
      push_crate(to, beyond);
    } else {
      bump(dir);
    }
    return;
  }
  player = to;
  move_t = MOVE_TICKS;
  push_cell = -1;
  sound(SOUND_STEP, 4, 0.04);
}

fn read_dir() {
  if (input(INPUT_LEFT) > 0) {
    return DIR_LEFT;
  }
  if (input(INPUT_RIGHT) > 0) {
    return DIR_RIGHT;
  }
  if (input(INPUT_UP) > 0) {
    return DIR_UP;
  }
  if (input(INPUT_DOWN) > 0) {
    return DIR_DOWN;
  }
  return -1;
}

// A fresh press moves at once; holding the key repeats after a short delay.
fn update_play() {
  let dir = read_dir();
  if (dir < 0) {
    last_dir = -1;
    repeat = 0;
    return;
  }
  if (dir != last_dir) {
    last_dir = dir;
    repeat = FIRST_REPEAT;
    try_move(dir);
    return;
  }
  repeat = repeat - 1;
  if (repeat <= 0) {
    repeat = NEXT_REPEAT;
    try_move(dir);
  }
}

fn advance() {
  if (current_level + 1 >= LEVEL_COUNT) {
    state = STATE_WON;
    sound(SOUND_WIN, 12, 0.2);
  } else {
    load_level(current_level + 1);
  }
}

fn tick_animation() {
  clock = clock + 1;
  if (clock > 100000) {
    clock = 0;
  }
  intro_t = min(intro_t + 1, 200);
  move_t = max(move_t - 1, 0);
  bump_t = max(bump_t - 1, 0);
  pulse_t = max(pulse_t - 1, 0);
  if (state == STATE_CLEAR) {
    clear_t = min(clear_t + 1, 1000);
  }
}

fn quad(x, y, w, h, r, g, b) {
  tri(x, y, x + w, y, x + w, y + h, r, g, b);
  tri(x, y, x + w, y + h, x, y + h, r, g, b);
}

fn diamond(cx, cy, size, r, g, b) {
  tri(cx, cy - size, cx + size, cy, cx, cy + size, r, g, b);
  tri(cx, cy - size, cx, cy + size, cx - size, cy, r, g, b);
}

// A thin diamond outline: four slanted bands of width `w`.
fn diamond_ring(cx, cy, size, w, r, g, b) {
  tri(cx, cy - size, cx + size, cy, cx + size - w, cy, r, g, b);
  tri(cx, cy - size, cx + size - w, cy, cx, cy - size + w, r, g, b);
  tri(cx + size, cy, cx, cy + size, cx, cy + size - w, r, g, b);
  tri(cx + size, cy, cx, cy + size - w, cx + size - w, cy, r, g, b);
  tri(cx, cy + size, cx - size, cy, cx - size + w, cy, r, g, b);
  tri(cx, cy + size, cx - size + w, cy, cx, cy + size - w, r, g, b);
  tri(cx - size, cy, cx, cy - size, cx, cy - size + w, r, g, b);
  tri(cx - size, cy, cx, cy - size + w, cx - size + w, cy, r, g, b);
}

fn background() {
  quad(0, 0, 800, 600, 0.07, 0.08, 0.14);
  tri(0, 600, 260, 300, 520, 600, 0.09, 0.1, 0.18);
  tri(380, 600, 640, 240, 800, 600, 0.1, 0.12, 0.2);
}

// Tiles drop in as a diagonal wave from the top-left corner. `age` is how long
// this cell has been alive; a negative age means it has not appeared yet.
fn cell_age(cx, cy) {
  return intro_t - (cx + cy) * 1.5;
}

fn cell_lift(age) {
  if (age >= INTRO_DROP_TICKS) {
    return 0;
  }
  let left = INTRO_DROP_TICKS - age;
  return left * left * 0.8;
}

fn draw_floor(x, y, cx, cy) {
  if ((cx + cy) % 2 == 0) {
    quad(x, y, TILE, TILE, 0.17, 0.23, 0.3);
  } else {
    quad(x, y, TILE, TILE, 0.15, 0.2, 0.27);
  }
}

fn draw_wall(x, y, cy) {
  quad(x, y, TILE, TILE, 0.2, 0.22, 0.34);
  quad(x + 3, y + 3, TILE - 6, TILE - 12, 0.36, 0.4, 0.56);
  quad(x + 3, y + 3, TILE - 6, 7, 0.52, 0.58, 0.74);
  quad(x + 3, y + 30, TILE - 6, 3, 0.26, 0.29, 0.43);
  quad(x + 20 + (cy % 2) * 24, y + 10, 3, 20, 0.26, 0.29, 0.43);
}

fn draw_target(x, y) {
  let glow = wave(90) * 2;
  diamond(x + 32, y + 32, 17 + glow, 0.95, 0.74, 0.25);
  diamond(x + 32, y + 32, 11 + glow, 0.12, 0.17, 0.23);
  diamond(x + 32, y + 32, 5, 0.95, 0.74, 0.25);
}

fn draw_crate(x, y, home) {
  let dark_r = 0.42;
  let dark_g = 0.24;
  let dark_b = 0.12;
  let lite_r = 0.82;
  let lite_g = 0.55;
  let lite_b = 0.26;
  if (home == 1) {
    dark_r = 0.1;
    dark_g = 0.4;
    dark_b = 0.24;
    lite_r = 0.34;
    lite_g = 0.84;
    lite_b = 0.5;
  }
  quad(x + 7, y + 9, TILE - 10, TILE - 10, 0.08, 0.11, 0.16);
  quad(x + 5, y + 5, TILE - 10, TILE - 10, dark_r, dark_g, dark_b);
  quad(x + 9, y + 9, TILE - 18, TILE - 18, lite_r, lite_g, lite_b);
  quad(x + 9, y + 29, TILE - 18, 6, dark_r, dark_g, dark_b);
  quad(x + 29, y + 9, 6, TILE - 18, dark_r, dark_g, dark_b);
  quad(x + 9, y + 9, TILE - 18, 4, lite_r + 0.1, lite_g + 0.15, lite_b + 0.15);
}

// A small porter; the eyes slide toward the facing direction.
fn draw_player(x, y, dir) {
  let ex = dir_dx(dir) * 4;
  let ey = dir_dy(dir) * 3;
  if (dir == DIR_DOWN) {
    ey = 2;
  }
  tri(x + 12, y + 56, x + 52, y + 56, x + 32, y + 62, 0.07, 0.09, 0.14);
  quad(x + 17, y + 30, 30, 26, 0.2, 0.52, 0.92);
  quad(x + 17, y + 30, 30, 7, 0.45, 0.75, 1);
  quad(x + 20, y + 10, 24, 22, 0.99, 0.82, 0.62);
  quad(x + 18, y + 7, 28, 8, 0.92, 0.3, 0.26);
  quad(x + 24 + ex, y + 20 + ey, 5, 6, 0.1, 0.1, 0.16);
  quad(x + 35 + ex, y + 20 + ey, 5, 6, 0.1, 0.1, 0.16);
  quad(x + 12, y + 34, 6, 16, 0.99, 0.82, 0.62);
  quad(x + 46, y + 34, 6, 16, 0.99, 0.82, 0.62);
  quad(x + 20, y + 54, 9, 5, 0.12, 0.14, 0.24);
  quad(x + 35, y + 54, 9, 5, 0.12, 0.14, 0.24);
}

// How far a thing that just moved in `move_dir` still has to slide, in pixels.
// It starts a full tile behind and eases out, so it decelerates into the cell.
fn slide_left() {
  let rest = move_t / MOVE_TICKS;
  return rest * rest * TILE;
}

fn board_tiles() {
  let cy = 0;
  while (cy < ROWS) {
    let cx = 0;
    while (cx < STRIDE) {
      let index = cy * STRIDE + cx;
      let kind = tile_at(index);
      let age = cell_age(cx, cy);
      if (kind >= TILE_WALL && age >= 0) {
        let x = origin_x + cx * TILE;
        let y = origin_y + cy * TILE - cell_lift(age);
        if (kind == TILE_WALL) {
          draw_wall(x, y, cy);
        } else {
          draw_floor(x, y, cx, cy);
          if (kind == TILE_TARGET) {
            draw_target(x, y);
          }
        }
      }
      cx = cx + 1;
    }
    cy = cy + 1;
  }
}

// Crates are drawn after every tile so a crate sliding in from a neighbouring
// cell is never covered by that cell's floor.
fn board_crates() {
  let i = 0;
  while (i < CELLS) {
    if (crate[i] == 1) {
      let cx = cell_col(i);
      let cy = cell_row(i);
      let age = cell_age(cx, cy);
      if (age >= 0) {
        let x = origin_x + cx * TILE;
        let y = origin_y + cy * TILE - cell_lift(age);
        if (i == push_cell && move_t > 0) {
          x = x - dir_dx(move_dir) * slide_left();
          y = y - dir_dy(move_dir) * slide_left();
        }
        let home = 0;
        if (tile_at(i) == TILE_TARGET) {
          home = 1;
        }
        draw_crate(x, y, home);
      }
    }
    i = i + 1;
  }
}

// A gold shockwave where a crate just landed on a target.
fn board_pulse() {
  if (pulse_t > 0) {
    let spent = 1 - pulse_t / PULSE_TICKS;
    let fade = 1 - spent;
    let cx = origin_x + cell_col(pulse_cell) * TILE + 32;
    let cy = origin_y + cell_row(pulse_cell) * TILE + 32;
    diamond_ring(cx, cy, 18 + spent * 34, 4 + fade * 4, 0.17 + 0.78 * fade, 0.23 + 0.51 * fade, 0.3 - 0.05 * fade);
  }
}

fn board_player() {
  let cx = cell_col(player);
  let cy = cell_row(player);
  let age = cell_age(cx, cy);
  if (age >= 0) {
    let x = origin_x + cx * TILE;
    let y = origin_y + cy * TILE - cell_lift(age);
    if (move_t > 0) {
      let behind = slide_left();
      x = x - dir_dx(move_dir) * behind;
      y = y - dir_dy(move_dir) * behind;
      // A little hop, highest in the middle of the step.
      let progress = 1 - move_t / MOVE_TICKS;
      y = y - (1 - abs(2 * progress - 1)) * 7;
    }
    if (bump_t > 0) {
      // Shake against the obstacle, getting smaller as it dies out.
      let shake = bump_t * 0.9;
      if (bump_t % 2 == 1) {
        shake = -shake;
      }
      x = x + dir_dx(bump_dir) * shake;
      y = y + dir_dy(bump_dir) * shake;
    }
    draw_player(x, y, facing);
  }
}

fn board() {
  board_tiles();
  board_crates();
  board_pulse();
  board_player();
}

fn hud() {
  let i = 0;
  while (i < LEVEL_COUNT) {
    let px = 400 + (i - 2.5) * 38;
    if (i < current_level || (i == current_level && state != STATE_PLAY)) {
      diamond(px, 30, 13, 0.34, 0.84, 0.5);
    } else if (i == current_level) {
      let size = 13 + wave(70) * 2;
      diamond(px, 30, size, 0.95, 0.74, 0.25);
      diamond(px, 30, 6, 0.45, 0.3, 0.1);
    } else {
      diamond(px, 30, 11, 0.22, 0.25, 0.36);
    }
    i = i + 1;
  }
  i = 0;
  while (i < LEVEL_BOXES[current_level]) {
    let px = 400 + (i - (LEVEL_BOXES[current_level] - 1) / 2) * 34;
    if (i < covered) {
      quad(px - 11, 566, 22, 22, 0.34, 0.84, 0.5);
    } else {
      quad(px - 11, 566, 22, 22, 0.22, 0.25, 0.36);
    }
    i = i + 1;
  }
}

// Confetti thrown up from (cx, cy), `t` ticks after the burst.
fn sparkles(cx, cy, t) {
  let i = 0;
  while (i < SPARK_COUNT) {
    let x = cx + SPARK_VX[i] * t;
    let y = cy + SPARK_VY[i] * t + 0.09 * t * t;
    let size = 10 - t * 0.17 - i % 3;
    if (size > 0) {
      if (i % 3 == 0) {
        diamond(x, y, size, 0.95, 0.74, 0.25);
      } else if (i % 3 == 1) {
        diamond(x, y, size, 0.34, 0.84, 0.5);
      } else {
        diamond(x, y, size, 0.85, 1, 0.9);
      }
    }
    i = i + 1;
  }
}

// The panel drops in from above and settles at y 200..400 (plus `slide`).
fn overlay_panel(r, g, b, slide) {
  quad(150, 200 - slide, 500, 200, r, g, b);
  quad(150, 200 - slide, 500, 14, r + 0.15, g + 0.15, b + 0.15);
  quad(150, 386 - slide, 500, 14, r * 0.6, g * 0.6, b * 0.6);
}

fn clear_scene() {
  let t = clear_t - CLEAR_PANEL_DELAY;
  if (t >= 0) {
    let drop = max(0, 16 - t);
    overlay_panel(0.1, 0.3, 0.2, drop * drop * 2);
    sparkles(400, 300, t);
    if (clear_t >= CLEAR_READY) {
      // The "play" triangle breathes once Space will continue.
      let grow = wave(50) * 8;
      tri(365, 255 - grow, 365, 345 + grow, 445 + grow, 300, 0.95, 0.74, 0.25);
      tri(365, 265 - grow, 365, 335 + grow, 430 + grow, 300, 1, 0.9, 0.5);
    }
  }
}

fn win_scene() {
  overlay_panel(0.14, 0.2, 0.34, 0);
  diamond(300, 300, 36 + wave(80) * 4, 0.95, 0.74, 0.25);
  diamond(400, 300, 52 + wave(60) * 5, 0.34, 0.84, 0.5);
  diamond(500, 300, 36 + wave(80) * 4, 0.95, 0.74, 0.25);
  diamond(400, 300, 24, 0.8, 1, 0.9);
  sparkles(250, 300, clock % 90);
  sparkles(400, 260, (clock + 30) % 90);
  sparkles(550, 300, (clock + 60) % 90);
}

fn scene() {
  background();
  if (state != STATE_WON) {
    board();
    hud();
  }
  if (state == STATE_CLEAR) {
    clear_scene();
  }
  if (state == STATE_WON) {
    win_scene();
  }
}

fn frame() {
  tick_animation();
  if (state == STATE_PLAY) {
    if (input(INPUT_RESTART) > 0) {
      load_level(current_level);
    } else {
      update_play();
    }
  } else if (state == STATE_CLEAR) {
    if (input(INPUT_ACTION_PRESSED) > 0 && clear_t >= CLEAR_READY) {
      advance();
    } else if (input(INPUT_RESTART) > 0) {
      load_level(current_level);
    }
  } else if (input(INPUT_ACTION_PRESSED) > 0 || input(INPUT_RESTART) > 0) {
    load_level(0);
  }
  scene();
}
