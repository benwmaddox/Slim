}

fn update_enemies() {
  let before = player_y - player_vy;
  if (enemy0_alive == 1 && absolute(player_x - 550) < 31 && absolute(player_y - (500 - 25)) < 29) {
    if (player_vy > 0 && before < 464) {
      enemy0_alive = 0;
      player_vy = -8;
      sound(1, 5, 0.18);
    } else {
      state = 2;
      sound(2, -5, 0.22);
    }
  }
  if (enemy1_alive == 1 && absolute(player_x - 1140) < 31 && absolute(player_y - (404 - 25)) < 29) {
    if (player_vy > 0 && before < 368) {
      enemy1_alive = 0;
      player_vy = -8;
      sound(1, 5, 0.18);
    } else {
      state = 2;
      sound(2, -5, 0.22);
    }
  }
  if (enemy2_alive == 1 && absolute(player_x - 1540) < 31 && absolute(player_y - (372 - 25)) < 29) {
    if (player_vy > 0 && before < 336) {
      enemy2_alive = 0;
      player_vy = -8;
      sound(1, 5, 0.18);
    } else {
      state = 2;
      sound(2, -5, 0.22);
    }
  }
  if (enemy3_alive == 1 && absolute(player_x - 1780) < 31 && absolute(player_y - (372 - 25)) < 29) {
    if (player_vy > 0 && before < 336) {
      enemy3_alive = 0;
      player_vy = -8;
      sound(1, 5, 0.18);
    } else {
      state = 2;
      sound(2, -5, 0.22);
    }
  }
  if (enemy4_alive == 1 && absolute(player_x - 3400) < 31 && absolute(player_y - (500 - 25)) < 29) {
    if (player_vy > 0 && before < 464) {
      enemy4_alive = 0;
      player_vy = -8;
      sound(1, 5, 0.18);
    } else {
      state = 2;
      sound(2, -5, 0.22);
    }
  }
  if (enemy5_alive == 1 && absolute(player_x - 4385) < 31 && absolute(player_y - (404 - 25)) < 29) {
