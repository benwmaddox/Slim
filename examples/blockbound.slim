fn bush(x, y) {
  if (visible(x - 45, x + 45) == 1) {
    let sx = x - camera_x;
    tri(sx - 42, y + 20, sx - 18, y - 28, sx + 8, y + 20, 0.16, 0.31, 0.18);
    tri(sx - 12, y + 20, sx + 15, y - 42, sx + 42, y + 20, 0.20, 0.43, 0.20);
    tri(sx - 19, y - 4, sx + 15, y - 42, sx + 22, y + 8, 0.38, 0.62, 0.24);
  }
}

// The first coat triangle is the stable hero marker used by the replay probe.
// Four parameters keep this renderer useful to small harnesses as well as the
// game itself: world feet position, facing, and walking/air pose.
fn hero(x, y, facing, pose) {
  let sx = x - camera_x;
  let step = pose % 2;
  tri(sx - 17, y - 58, sx + 18, y - 54, sx + 3, y - 18, 0.95, 0.32, 0.1);
  tri(sx - 17, y - 58, sx + 3, y - 18, sx - 16, y - 18, 0.64, 0.16, 0.08);
  tri(sx - 14, y - 53, sx - 1, y - 52, sx - 8, y - 27, 0.82, 0.24, 0.08);
  tri(sx - 1, y - 52, sx + 13, y - 48, sx + 3, y - 24, 0.56, 0.13, 0.07);
  tri(sx - 8, y - 36, sx + 3, y - 44, sx + 6, y - 25, 0.98, 0.58, 0.16);
  tri(sx - 15, y - 28, sx - 3, y - 29, sx - 7, y - 18, 0.42, 0.10, 0.06);
  tri(sx + 3, y - 28, sx + 15, y - 30, sx + 9, y - 18, 0.36, 0.09, 0.06);
  tri(sx - 18, y - 41, sx - 28, y - 37, sx - 18, y - 29, 0.98, 0.72, 0.29);
  tri(sx + 15, y - 40, sx + 26, y - 36, sx + 16, y - 28, 0.98, 0.72, 0.29);
  tri(sx - 16, y - 78, sx + 15, y - 78, sx + 18, y - 51, 0.96, 0.44, 0.12);
  tri(sx - 14, y - 77, sx - 4, y - 97, sx + 1, y - 76, 0.78, 0.21, 0.08);
  tri(sx + 2, y - 76, sx + 14, y - 97, sx + 18, y - 76, 0.78, 0.21, 0.08);
  tri(sx - 9, y - 82, sx - 4, y - 91, sx - 1, y - 81, 0.17, 0.09, 0.08);
  tri(sx + 6, y - 81, sx + 13, y - 91, sx + 15, y - 80, 0.17, 0.09, 0.08);
  tri(sx + 5, y - 63, sx + 22, y - 57, sx + 11, y - 46, 1, 0.78, 0.42);
  tri(sx + 11, y - 53, sx + 24, y - 49, sx + 12, y - 44, 0.25, 0.08, 0.04);
  tri(sx - 3, y - 72, sx + 5, y - 68, sx + 2, y - 57, 0.98, 0.86, 0.48);
  tri(sx + 3, y - 70, sx + 10, y - 68, sx + 7, y - 58, 0.76, 0.22, 0.08);
  tri(sx - 17, y - 21, sx - 4, y - 24, sx - 4, y - 16, 0.77, 0.28, 0.10);
  tri(sx + 4, y - 24, sx + 17, y - 21, sx + 4, y - 16, 0.62, 0.17, 0.08);
  if (facing > 0) {
    tri(sx - 15, y - 51, sx - 43, y - 35, sx - 18, y - 30, 0.87, 0.25, 0.08);
    tri(sx - 41, y - 35, sx - 53, y - 25, sx - 18, y - 30, 0.52, 0.12, 0.07);
  } else {
    tri(sx + 17, y - 51, sx + 45, y - 35, sx + 18, y - 30, 0.87, 0.25, 0.08);
    tri(sx + 43, y - 35, sx + 55, y - 25, sx + 18, y - 30, 0.52, 0.12, 0.07);
  }
  tri(sx - 17, y - 46, sx - 29, y - 32, sx - 16, y - 28, 0.96, 0.44, 0.12);
  tri(sx + 15, y - 46, sx + 28, y - 32, sx + 16, y - 28, 0.96, 0.44, 0.12);
  if (step == 0 || pose == 2) {
    tri(sx - 13, y - 20, sx - 4, y - 20, sx - 10, y - 3, 0.29, 0.13, 0.12);
    tri(sx + 4, y - 20, sx + 13, y - 20, sx + 9, y - 3, 0.29, 0.13, 0.12);
  } else {
    tri(sx - 14, y - 20, sx - 5, y - 20, sx - 16, y - 3, 0.29, 0.13, 0.12);
    tri(sx + 5, y - 20, sx + 14, y - 20, sx + 18, y - 3, 0.29, 0.13, 0.12);
  }
  tri(sx - 15, y - 5, sx - 2, y - 5, sx - 14, y, 0.11, 0.09, 0.09);
  tri(sx + 2, y - 5, sx + 15, y - 5, sx + 15, y, 0.11, 0.09, 0.09);
}

// Beetle enemies use a low, faceted shell and two angular legs per side.
fn enemy_shape(x, y, pose) {
  if (visible(x - 36, x + 36) == 1) {
    let sx = x - camera_x;
    let twitch = pose % 2;
    tri(sx - 27, y - 22, sx, y - 46, sx + 27, y - 22, 0.48, 0.13, 0.10);
    tri(sx - 27, y - 22, sx + 27, y - 22, sx, y - 4, 0.32, 0.08, 0.10);
    tri(sx - 19, y - 23, sx, y - 41, sx - 2, y - 7, 0.77, 0.29, 0.12);
    tri(sx + 19, y - 23, sx + 2, y - 7, sx, y - 41, 0.60, 0.16, 0.09);
    tri(sx - 8, y - 40, sx + 8, y - 40, sx, y - 8, 0.92, 0.51, 0.13);
    tri(sx - 21, y - 8, sx - 37, y + twitch - 1, sx - 16, y - 13, 0.19, 0.10, 0.10);
    tri(sx + 21, y - 8, sx + 37, y + twitch - 1, sx + 16, y - 13, 0.19, 0.10, 0.10);
    tri(sx - 16, y - 4, sx - 30, y + 8 + twitch, sx - 9, y - 8, 0.19, 0.10, 0.10);
    tri(sx + 16, y - 4, sx + 30, y + 8 + twitch, sx + 9, y - 8, 0.19, 0.10, 0.10);
    tri(sx - 8, y - 43, sx - 15, y - 57, sx - 4, y - 45, 0.30, 0.10, 0.08);
    tri(sx + 8, y - 43, sx + 15, y - 57, sx + 4, y - 45, 0.30, 0.10, 0.08);
    tri(sx - 14, y - 30, sx - 8, y - 35, sx - 4, y - 29, 0.96, 0.88, 0.42);
    tri(sx + 4, y - 29, sx + 8, y - 35, sx + 14, y - 30, 0.96, 0.88, 0.42);
  }
}

