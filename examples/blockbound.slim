fn scene() {
  background();
  if (state == 0) {
    course();
    enemies();
    beacon();
    hero(player_x, player_y, player_facing, player_pose);
    hud();
  }
  if (state == 1) {
    terminal_win();
  }
  if (state == 2) {
    terminal_loss();
  }
}

