fn absolute(value) {
  if (value < 0) {
    return -value;
  }
  return value;
}

fn clamp(value, low, high) {
  if (value < low) {
    return low;
  }
  if (value > high) {
    return high;
  }
  return value;
}

fn visible(left, right) {
  if (right > camera_x - 40 && left < camera_x + 840) {
    return 1;
  }
  return 0;
}

// Highest walkable top at a world x that the descending feet crossed.
// -1000 marks a gap. The previous feet y keeps a raised block from making the
// ground beneath it disappear when the fox is walking under that block.
fn surface(x, previous) {
  let top = -1000;
  if (x >= 0 && x < 2200 && previous <= 500) {
    top = 500;
  }
  if (x >= 2320 && x < 2820 && previous <= 500) {
    top = 500;
  }
  if (x >= 2940 && x < 4420 && previous <= 500) {
    top = 500;
  }
  if (x >= 4660 && x < 4900 && previous <= 500) {
    top = 500;
  }
  if (x >= 5000 && x < 6800 && previous <= 500) {
    top = 500;
  }

  if (x >= 420 && x < 540 && previous <= 350 && (top < -500 || top > 350)) {
    top = 350;
  }
  if (x >= 700 && x < 764 && previous <= 436 && (top < -500 || top > 436)) {
    top = 436;
  }
  if (x >= 1100 && x < 1180 && previous <= 404 && (top < -500 || top > 404)) {
    top = 404;
  }
  if (x >= 1320 && x < 1450 && previous <= 360 && (top < -500 || top > 360)) {
    top = 360;
  }

  if (x >= 1500 && x < 1580 && previous <= 372 && (top < -500 || top > 372)) {
    top = 372;
  }
  if (x >= 1740 && x < 1820 && previous <= 372 && (top < -500 || top > 372)) {
    top = 372;
  }

  if (x >= 2500 && x < 2640 && previous <= 350 && (top < -500 || top > 350)) {
    top = 350;
  }
  if (x >= 3100 && x < 3260 && previous <= 320 && (top < -500 || top > 320)) {
    top = 320;
  }
  if (x >= 3600 && x < 3750 && previous <= 360 && (top < -500 || top > 360)) {
    top = 360;
  }
  if (x >= 3850 && x < 4000 && previous <= 280 && (top < -500 || top > 280)) {
    top = 280;
  }

  if (x >= 4210 && x < 4280 && previous <= 468 && (top < -500 || top > 468)) {
    top = 468;
  }
  if (x >= 4280 && x < 4350 && previous <= 436 && (top < -500 || top > 436)) {
    top = 436;
  }
  if (x >= 4350 && x < 4420 && previous <= 404 && (top < -500 || top > 404)) {
    top = 404;
  }
  if (x >= 4660 && x < 4730 && previous <= 468 && (top < -500 || top > 468)) {
    top = 468;
  }
  if (x >= 4730 && x < 4800 && previous <= 436 && (top < -500 || top > 436)) {
    top = 436;
  }
  if (x >= 4800 && x < 4870 && previous <= 404 && (top < -500 || top > 404)) {
    top = 404;
  }

  if (x >= 5800 && x < 5880 && previous <= 468 && (top < -500 || top > 468)) {
    top = 468;
  }
  if (x >= 5880 && x < 5960 && previous <= 430 && (top < -500 || top > 430)) {
    top = 430;
  }
  if (x >= 5960 && x < 6040 && previous <= 392 && (top < -500 || top > 392)) {
    top = 392;
  }
  if (x >= 6040 && x < 6120 && previous <= 354 && (top < -500 || top > 354)) {
    top = 354;
  }
  if (x >= 6120 && x < 6200 && previous <= 316 && (top < -500 || top > 316)) {
    top = 316;
  }

  return top;
}

fn rectangle(x, y, width, height, red, green, blue) {
  tri(x - width / 2, y - height / 2, x + width / 2, y - height / 2, x + width / 2, y + height / 2, red, green, blue);
  tri(x - width / 2, y - height / 2, x + width / 2, y + height / 2, x - width / 2, y + height / 2, red, green, blue);
}

fn ground_segment(left, right, top, red, green, blue) {
  if (visible(left, right) == 1) {
    let a = left - camera_x;
    let b = right - camera_x;
    tri(a, top, b, top, b, 600, red, green, blue);
    tri(a, top, b, 600, a, 600, red, green, blue);
    tri(a, top, b, top, b, top + 11, 0.98, 0.55, 0.16);
    tri(a, top, b, top + 11, a, top + 11, 0.82, 0.31, 0.12);
  }
}

fn platform(x, top, width) {
  if (visible(x - width / 2, x + width / 2) == 1) {
    let a = x - width / 2 - camera_x;
    let b = x + width / 2 - camera_x;
    tri(a, top, b, top, b, top + 26, 0.46, 0.18, 0.13);
    tri(a, top, b, top + 26, a, top + 26, 0.32, 0.11, 0.12);
    tri(a, top, b, top, b, top + 8, 0.98, 0.57, 0.18);
    tri(a, top, b, top + 8, a, top + 8, 0.73, 0.27, 0.12);
  }
}

fn pillar(x, top, width) {
  if (visible(x - width / 2, x + width / 2) == 1) {
    let a = x - width / 2 - camera_x;
    let b = x + width / 2 - camera_x;
    tri(a, top, b, top, b, 500, 0.47, 0.18, 0.13);
    tri(a, top, b, 500, a, 500, 0.30, 0.10, 0.11);
    tri(a, top, b, top, b, top + 9, 0.98, 0.55, 0.16);
    tri(a, top, b, top + 9, a, top + 9, 0.76, 0.27, 0.12);
  }
}

// Rectangles use the same world bounds for drawing and collision. A side hit
// stops horizontal motion; a rising fox stops at the underside of a block.
fn solid_rect(left, right, top, bottom, old_x, old_y) {
  if (player_y > top + 2 && player_y - 82 < bottom) {
    if (old_x <= left - 18 && player_x > left - 18) {
      player_x = left - 18;
      player_vx = 0;
    }
    if (old_x >= right + 18 && player_x < right + 18) {
      player_x = right + 18;
      player_vx = 0;
    }
  }
  if (player_vy < 0 && player_x > left - 18 && player_x < right + 18 && old_y - 97 >= bottom && player_y - 97 < bottom) {
    player_y = bottom + 97;
    player_vy = 0;
  }
}

