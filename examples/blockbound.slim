fn update_player() {
  let direction = 0;
  if (input(0) > 0) {
    direction = direction - 1;
  }
  if (input(1) > 0) {
    direction = direction + 1;
  }
  if (direction != 0) {
    player_vx = player_vx + direction * 0.72;
    player_facing = direction;
  } else {
    player_vx = player_vx * 0.78;
  }
  player_vx = clamp(player_vx, -6, 6);

  if (input(5) > 0 && player_ground == 1) {
    player_vy = -15;
    player_ground = 0;
    jump_hold = 8;
    sound(0, 8, 0.08);
  }
  if (input(4) > 0 && player_vy < 0 && jump_hold > 0) {
    player_vy = player_vy - 0.30;
    jump_hold = jump_hold - 1;
  } else {
    jump_hold = 0;
  }
  player_vy = player_vy + 0.72;
  player_vy = clamp(player_vy, -16, 15);

  let old_x = player_x;
  let old_y = player_y;
  player_x = player_x + player_vx;
  player_x = clamp(player_x, 18, 6770);
  player_y = player_y + player_vy;
  solid_course(old_x, old_y);
  let top = surface(player_x, old_y);
  if (player_vy >= 0 && top > -500 && old_y <= top && player_y >= top) {
    player_y = top;
    player_vy = 0;
    player_ground = 1;
  } else {
    player_ground = 0;
  }
  if (player_y > 680) {
    state = 2;
    sound(2, -5, 0.22);
  }

  update_enemies();
  if (player_x > 6620 && state == 0) {
    state = 1;
    progress_marks = 1;
    sound(3, 12, 0.22);
  }
  if (player_x > 1000 && progress_marks == 0) {
    progress_marks = 1;
  }
  if (player_x > 3300 && progress_marks == 1) {
    progress_marks = 2;
  }
  if (player_x > 5200 && progress_marks == 2) {
    progress_marks = 3;
  }
}

fn update_camera() {
  if (player_x - camera_x > 280) {
    camera_x = player_x - 280;
  }
  if (camera_x < 0) {
    camera_x = 0;
  }
  if (camera_x > 6000) {
    camera_x = 6000;
  }
}

fn update() {
  walk_clock = walk_clock + 1;
  if (walk_clock > 10000) {
    walk_clock = 0;
  }
  update_player();
  update_camera();
  if (player_ground == 0) {
    player_pose = 2;
  } else if (absolute(player_vx) > 0.2) {
    player_pose = walk_clock % 2;
  } else {
    player_pose = 0;
  }
}

fn frame() {
  if (input(9) > 0) {
    init();
  } else if (state == 0) {
    update();
  } else if (input(5) > 0) {
    init();
  }
  scene();
}
